{
  "manifest_version": 3,
  "name": "Waifu Display",
  "version": "2.1.0",
  "description": "Display your favorite characters on any webpage. Supports multiple character sources.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://sinoalice.game-db.tw/*",
    "https://wutheringwaves.kurogames.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*",
    "https://bluearchive.wikiru.jp/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Waifu Display"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}